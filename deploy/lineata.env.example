# lineATA service environment — EXAMPLE ONLY, contains no real values.
# Comments must stay on their own lines: in an EnvironmentFile, text after a
# value (including '#') is preserved as part of the value.
#
# Install as a root-owned secret file, then edit the installed copy:
#   install -o root -g root -m 0600 deploy/lineata.env.example /etc/lineata.env
#   editor /etc/lineata.env
# Never commit real values. systemd (PID 1) reads this file via
# EnvironmentFile=/etc/lineata.env and passes the variables into the daemon's
# environment. Only LINEATA_SIP_PASSWORD is a secret; it is never passed on
# the service command line.

# PBX host for SIP/UDP (generic placeholder domain)
LINEATA_PBX=pbx.example.invalid
# PBX SIP port (1-65535)
LINEATA_PBX_PORT=5060
# SIP extension / login
LINEATA_LOGIN=2005
# This host's IPv4 address (TEST-NET-1 placeholder, not a real host)
LINEATA_LOCAL_IP=192.0.2.10
# Local SIP/UDP listen port (1-65535)
LINEATA_SIP_PORT=5062
# SIP digest secret (placeholder; real value entered only in /etc/lineata.env)
LINEATA_SIP_PASSWORD=change-me
